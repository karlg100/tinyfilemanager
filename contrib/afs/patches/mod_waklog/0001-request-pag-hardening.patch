+              "mod_waklog: refusing further work for a quarantined request");
+    return -1;
+  }
+
+  if (cfg == NULL || child.cleanup_failed) {
+    log_error(APLOG_MARK, APLOG_ERR, 0, r->server,
+              "mod_waklog: missing configuration or quarantined worker");
+    return -1;
