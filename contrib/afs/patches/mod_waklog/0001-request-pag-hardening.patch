+
+#include <stddef.h>
+
+typedef int (*waklog_guard_operation)(void *);
+
+struct waklog_request_guard {
+  const void *owner;
+  int active;
+};
+
+enum waklog_guard_result {
+  WAKLOG_GUARD_OK = 0,
+  WAKLOG_GUARD_BUSY = -1,
+  WAKLOG_GUARD_FORGET_FAILED = -2,
+  WAKLOG_GUARD_SETPAG_FAILED = -3
+};
+
+int waklog_request_guard_begin(struct waklog_request_guard *guard,
+                               const void *owner,
+                               waklog_guard_operation forget_tokens,
+                               waklog_guard_operation create_pag,
+                               void *operation_context);
+
+int waklog_request_guard_cleanup(struct waklog_request_guard *guard,
+                                 const void *owner,
+                                 waklog_guard_operation forget_tokens,
+                                 void *operation_context);
+
+int waklog_copy_counted(char *destination,
+                        size_t destination_size,
+                        const void *source,
+                        size_t source_size);
+
+int waklog_copy_string(char *destination,
+                       size_t destination_size,
+                       const char *source);
+
+int waklog_runtime_is_safe(const char *mpm_name,
+                           int mpm_is_threaded,
+                           int http2_loaded,
+                           int fastcgi_loaded);
+
+#endif
