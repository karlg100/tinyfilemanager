+        request_guard.owner != owner || request_config == NULL ||
+        !waklog_config_is_same_security_context(request_config, cfg)) {
+      return waklog_quarantine_request(
+          r, "mod_waklog: refusing internal redirect that changes the "
+          "root request credential policy");
+    }
+    return 0;
+  }
+
+  if (needs_credentials) {
+    if (request_config != NULL &&
+        !waklog_config_is_same_security_context(request_config, cfg)) {
+      return waklog_quarantine_request(
+          r, "mod_waklog: root request credential policy changed");
