diff --git a/test_hardening.c b/test_hardening.c
new file mode 100644
index 0000000..329c4b4
--- /dev/null
+++ b/test_hardening.c
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: LicenseRef-mod-waklog-UMich */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "waklog_hardening.h"
+
+#define CHECK(expression) do { \
+  if (!(expression)) { \
+    fprintf(stderr, "CHECK failed at %s:%d: %s\n", \
+            __FILE__, __LINE__, #expression); \
+    exit(EXIT_FAILURE); \
+  } \
+} while (0)
+
+struct mock_operations {
+  int forget_rc;
+  int setpag_rc;
+  int forget_calls;
+  int setpag_calls;
+};
+
+static int
+mock_forget(void *data)
+{
+  struct mock_operations *ops = data;
+  ops->forget_calls++;
+  return ops->forget_rc;
+}
+
+static int
+mock_setpag(void *data)
+{
+  struct mock_operations *ops = data;
+  ops->setpag_calls++;
+  return ops->setpag_rc;
+}
+
+static void
+test_request_lifecycle(void)
+{
+  struct waklog_request_guard guard = {0};
+  struct mock_operations ops = {0};
+  int request_a = 0;
+  int request_b = 0;
+
+  CHECK(waklog_request_guard_begin(&guard, &request_a, mock_forget,
+                                    mock_setpag, &ops) == WAKLOG_GUARD_OK);
+  CHECK(guard.active == 1 && guard.owner == &request_a);
+  CHECK(ops.forget_calls == 1 && ops.setpag_calls == 1);
+
+  CHECK(waklog_request_guard_begin(&guard, &request_a, mock_forget,
+                                    mock_setpag, &ops) == WAKLOG_GUARD_OK);
+  CHECK(ops.forget_calls == 1 && ops.setpag_calls == 1);
+
+  CHECK(waklog_request_guard_begin(&guard, &request_b, mock_forget,
+                                    mock_setpag, &ops) == WAKLOG_GUARD_BUSY);
+  CHECK(guard.owner == &request_a);
+
+  CHECK(waklog_request_guard_cleanup(&guard, &request_a, mock_forget,
+                                      &ops) == WAKLOG_GUARD_OK);
+  CHECK(guard.active == 0 && guard.owner == NULL);
+  CHECK(ops.forget_calls == 2);
+}
+
+static void
+test_fail_closed_operations(void)
+{
+  struct waklog_request_guard guard = {0};
+  struct mock_operations ops = {.forget_rc = 5};
+  int request = 0;
+
+  CHECK(waklog_request_guard_begin(&guard, &request, mock_forget,
+                                    mock_setpag, &ops) ==
+         WAKLOG_GUARD_FORGET_FAILED);
+  CHECK(guard.active == 0 && ops.setpag_calls == 0);
+
+  ops.forget_rc = 0;
+  ops.setpag_rc = 7;
+  CHECK(waklog_request_guard_begin(&guard, &request, mock_forget,
+                                    mock_setpag, &ops) ==
+         WAKLOG_GUARD_SETPAG_FAILED);
+  CHECK(guard.active == 0);
+
+  ops.setpag_rc = 0;
+  CHECK(waklog_request_guard_begin(&guard, &request, mock_forget,
+                                    mock_setpag, &ops) == WAKLOG_GUARD_OK);
+  ops.forget_rc = 9;
+  CHECK(waklog_request_guard_cleanup(&guard, &request, mock_forget,
+                                      &ops) ==
+         WAKLOG_GUARD_FORGET_FAILED);
+  CHECK(guard.active == 0 && guard.owner == NULL);
+}
+
+static void
+test_bounded_copy_and_runtime_contract(void)
+{
+  char buffer[4] = { 'x', 'x', 'x', 'x' };
+
+  CHECK(waklog_copy_counted(buffer, sizeof(buffer), "abc", 3) == 0);
+  CHECK(strcmp(buffer, "abc") == 0);
+  CHECK(waklog_copy_counted(buffer, sizeof(buffer), "abcd", 4) == -1);
+  CHECK(waklog_copy_string(buffer, sizeof(buffer), "abc") == 0);
+  CHECK(waklog_copy_string(buffer, sizeof(buffer), "abcd") == -1);
+  CHECK(waklog_copy_string(buffer, sizeof(buffer), NULL) == -1);
+  CHECK(waklog_copy_counted(NULL, sizeof(buffer), "a", 1) == -1);
+  CHECK(waklog_copy_counted(buffer, 0, "a", 1) == -1);
+
+  CHECK(waklog_runtime_is_safe("prefork", 0, 0, 0) == 1);
+  CHECK(waklog_runtime_is_safe("event", 1, 0, 0) == 0);
+  CHECK(waklog_runtime_is_safe("prefork", 0, 1, 0) == 0);
+  CHECK(waklog_runtime_is_safe("prefork", 0, 0, 1) == 0);
+}
+
+int
+main(void)
+{
+  test_request_lifecycle();
+  test_fail_closed_operations();
+  test_bounded_copy_and_runtime_contract();
+  puts("hardening unit tests: PASS");
+  return 0;
+}
diff --git a/waklog_hardening.c b/waklog_hardening.c
new file mode 100644
index 0000000..3b07b99
--- /dev/null
+++ b/waklog_hardening.c
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: LicenseRef-mod-waklog-UMich */
+#include <stddef.h>
+#include <string.h>
+
+#include "waklog_hardening.h"
+
+int
+waklog_request_guard_begin(struct waklog_request_guard *guard,
+                           const void *owner,
+                           waklog_guard_operation forget_tokens,
+                           waklog_guard_operation create_pag,
+                           void *operation_context)
+{
+  if (guard == NULL || owner == NULL || forget_tokens == NULL ||
+      create_pag == NULL) {
+    return WAKLOG_GUARD_SETPAG_FAILED;
+  }
+
+  if (guard->active) {
+    return guard->owner == owner ? WAKLOG_GUARD_OK : WAKLOG_GUARD_BUSY;
+  }
+
+  if (forget_tokens(operation_context) != 0) {
+    return WAKLOG_GUARD_FORGET_FAILED;
+  }
+
+  if (create_pag(operation_context) != 0) {
+    return WAKLOG_GUARD_SETPAG_FAILED;
+  }
+
+  guard->owner = owner;
+  guard->active = 1;
+  return WAKLOG_GUARD_OK;
+}
+
+int
+waklog_request_guard_cleanup(struct waklog_request_guard *guard,
+                             const void *owner,
+                             waklog_guard_operation forget_tokens,
+                             void *operation_context)
+{
+  int rc;
+
+  if (guard == NULL || owner == NULL || forget_tokens == NULL ||
+      !guard->active || guard->owner != owner) {
+    return WAKLOG_GUARD_BUSY;
+  }
+
+  rc = forget_tokens(operation_context);
+  guard->owner = NULL;
+  guard->active = 0;
+
+  return rc == 0 ? WAKLOG_GUARD_OK : WAKLOG_GUARD_FORGET_FAILED;
+}
+
+int
+waklog_copy_counted(char *destination,
+                    size_t destination_size,
+                    const void *source,
+                    size_t source_size)
+{
+  if (destination == NULL || destination_size == 0 || source == NULL ||
+      source_size >= destination_size) {
+    return -1;
+  }
+
+  memcpy(destination, source, source_size);
+  destination[source_size] = '\0';
+  return 0;
+}
+
+int
+waklog_copy_string(char *destination,
+                   size_t destination_size,
+                   const char *source)
+{
+  return source == NULL ? -1 :
+      waklog_copy_counted(destination, destination_size,
+                          source, strlen(source));
+}
+
+int
+waklog_runtime_is_safe(const char *mpm_name,
+                       int mpm_is_threaded,
+                       int http2_loaded,
+                       int fastcgi_loaded)
+{
+  return mpm_name != NULL && strcmp(mpm_name, "prefork") == 0 &&
+         !mpm_is_threaded && !http2_loaded && !fastcgi_loaded;
+}
