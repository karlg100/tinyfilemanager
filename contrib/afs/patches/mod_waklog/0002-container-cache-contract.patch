+static int
+waklog_delegated_cache_is_safe(const char *ccname)
+{
+  const char *suffix;
+  const char *path;
+  char *end;
+  long owner;
+  struct stat st;
+  size_t index;
+
+  if (ccname == NULL ||
+      strncmp(ccname, WAKLOG_CCACHE_PREFIX,
+              sizeof(WAKLOG_CCACHE_PREFIX) - 1) != 0) {
+    return 0;
+  }
+
+  suffix = ccname + sizeof(WAKLOG_CCACHE_PREFIX) - 1;
+  errno = 0;
+  owner = strtol(suffix, &end, 10);
+  if (errno != 0 || end == suffix || *end != '-' ||
+      owner != (long)getpid())
+    return 0;
+  suffix = end + 1;
+  if (strlen(suffix) != 6)
+    return 0;
+  for (index = 0; index < 6; index++) {
+    if (!((suffix[index] >= 'a' && suffix[index] <= 'z') ||
+          (suffix[index] >= 'A' && suffix[index] <= 'Z') ||
+          (suffix[index] >= '0' && suffix[index] <= '9'))) {
+      return 0;
+    }
+  }
+
+  path = ccname + strlen("FILE:");
+  if (lstat(path, &st) != 0 || !S_ISREG(st.st_mode) ||
+      st.st_uid != geteuid() || st.st_gid != getegid() ||
+      (st.st_mode & 07777) != 0600 || st.st_nlink != 1) {
+    return 0;
+  }
+  return 1;
 }
 
