# Source this file from the repository root. It contains no secrets.
# The provider and output images contain licensed files. Keep both private;
# never push them to a public registry. Pin the provider by immutable digest.
TFM_AURISTOR_PROJECT=tinyfilemanager-auristor-test
TFM_AURISTOR_IMAGE=tinyfilemanager-auristor:local
TFM_AURISTOR_PROVIDER_IMAGE=localhost:5000/tinyfilemanager-auristor-provider@sha256:REPLACE_WITH_64_HEX_DIGEST
TFM_PUBLIC_HOST=files.example.com
TFM_AD_REALM=EXAMPLE.COM
TFM_AFS_CELL=example.org
TFM_AFS_REALM=EXAMPLE.COM
TFM_HTTPS_PORT=10443
TFM_BIND_ADDRESS=127.0.0.1
TFM_AFS_SOURCE=/afs/example.org/service/tinyfilemanager-auristor-test
TFM_AURISTOR_CONFIG_PATH=$PWD/contrib/afs/yfs-client.conf
TFM_CONFIG_PATH=$PWD/contrib/afs/config.php
TFM_KRB5_CONFIG_PATH=$PWD/contrib/afs/krb5.conf
TFM_AUTHORIZED_USERS_PATH=$PWD/contrib/afs/authorized-users
TFM_TLS_CERT_PATH=$PWD/contrib/afs/tls.crt
TFM_TLS_KEY_PATH=$PWD/contrib/afs/tls.key
# Option A default. Option B uses /var/lib/tinyfilemanager-keytab/keytabs.
TFM_KEYTAB_DIR=$PWD/contrib/afs/keytab
