# Record the exact working HAProxy deployment here before testing AFS.
# Source this file from the repository root. It contains no secrets.
TFM_PROJECT=tinyfilemanager-ad
TFM_PUBLIC_HOST=files.example.com
TFM_AD_REALM=EXAMPLE.COM
TFM_HTTPS_PORT=8443
TFM_BIND_ADDRESS=127.0.0.1
TFM_CONFIG_PATH=$PWD/contrib/haproxy/config.php
TFM_KRB5_CONFIG_PATH=$PWD/contrib/haproxy/krb5.conf
TFM_AUTHORIZED_USERS_PATH=$PWD/contrib/haproxy/authorized-users
TFM_TLS_CERT_PATH=$PWD/contrib/haproxy/tls.crt
TFM_TLS_KEY_PATH=$PWD/contrib/haproxy/tls.key
TFM_KEYTAB_DIR=$PWD/contrib/haproxy/keytab
# If the working stack uses compose.host-path.yaml, record its absolute path.
# TFM_DATA_PATH=/srv/tinyfilemanager-data
