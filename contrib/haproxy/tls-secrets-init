#!/bin/sh
set -eu

fail() {
    printf 'tinyfilemanager-tls-init: %s\n' "$1" >&2
    exit 1
}

source_cert=/run/secrets-source/tls.crt
source_key=/run/secrets-source/tls.key
runtime_dir=/run/tls-runtime

[ -f "$source_cert" ] && [ ! -L "$source_cert" ] && [ -s "$source_cert" ] \
    || fail 'tls.crt must be a non-empty regular file'
[ -f "$source_key" ] && [ ! -L "$source_key" ] && [ -s "$source_key" ] \
    || fail 'tls.key must be a non-empty regular file'

install -d -o root -g root -m 0700 "$runtime_dir"
install -o root -g root -m 0444 "$source_cert" "$runtime_dir/.tls.crt.new"
install -o root -g root -m 0400 "$source_key" "$runtime_dir/.tls.key.new"
mv -f "$runtime_dir/.tls.crt.new" "$runtime_dir/tls.crt"
mv -f "$runtime_dir/.tls.key.new" "$runtime_dir/tls.key"

[ "$(stat -c '%u:%g %a' "$runtime_dir/tls.key")" = '0:0 400' ] \
    || fail 'TLS private key ownership or mode is unsafe'
