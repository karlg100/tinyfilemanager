#!/bin/sh
set -eu

host=${TFM_PUBLIC_HOST:-}
case "$host" in
    ''|.*|*.|*..*|*[!a-z0-9.-]*)
        exit 1
        ;;
esac

response=$(wget --no-check-certificate --spider -S -T 3 \
    --header "Host: $host" \
    "https://127.0.0.1:8443/healthz.php" 2>&1) || exit 1

printf '%s\n' "$response" | grep -Eq 'HTTP/[0-9.]+ 204([[:space:]]|$)'
